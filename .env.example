# EstateFlow local development configuration.
# Copy to .env locally and fill real secrets there. Do not commit .env.

ENVIRONMENT=development
DEPLOYMENT_ROLE=full
SERVICE_NAME=estateflow-api
LOG_LEVEL=INFO
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_PORT=8001
INTERNAL_API_PORT=8002
WORKER_STAGE=all
QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://estateflow:change-me@rabbitmq:5672/
RABBITMQ_EXCHANGE=estateflow.events
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=3

# Required only outside development/test. Use a high-entropy value in production.
APP_SECRET_KEY=
ADMIN_API_TOKEN=
SOURCE_SUGGESTION_INGRESS_TOKEN=
INGESTION_SOURCES_JSON=[]

# DigitalOcean PostgreSQL. On the laptop, port 6529 is forwarded to the VPS.
# Development uses the isolated estateflow_dev database and dev role.
DB_DRIVER=postgresql+asyncpg
DB_SYNC_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=6529
DB_NAME=estateflow_dev
DB_USER=estateflow_dev__dev_user
DB_PASSWORD=
# In production Compose, use the app role at runtime and the dev role for migrations.
MIGRATION_DB_USER=estateflow_dev__dev_user
MIGRATION_DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# User-facing Telegram bot. Leave empty for local skeleton tests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=https://example.com

# Separate operations bot/channel for internal alerts. Leave empty to disable.
OPS_BOT_TOKEN=
OPS_CHAT_ID=

# Public content channel automation. Leave empty for dry-run/no-op local runs.
CONTENT_CHANNEL_BOT_TOKEN=
CONTENT_CHANNEL_CHAT_ID=
CONTENT_DAILY_POST_LIMIT=2

# Telethon listener account pool placeholders. Never commit session files.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_DIR=data/sessions
# Separate authorized session for AI media downloads; do not reuse the active listener session.
TELEGRAM_MEDIA_SESSION_NAME=media-acc_9889
TELEGRAM_ALBUM_DEBOUNCE_SECONDS=1.5
PRE_AI_NEAR_TEXT_THRESHOLD=0.88
PRE_AI_PHASH_HAMMING_THRESHOLD=8

# AI and object storage placeholders. No real calls are made by the skeleton.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_SEQUENCE=google/gemini-3.1-flash-lite,google/gemini-3.1-flash-lite-preview
OPENROUTER_TIMEOUT_SECONDS=30
AI_MIN_CONFIDENCE=0.72
RENTAL_MIN_CONFIDENCE=0.60
AI_PROMPT_VERSION=estateflow.listing.v1
R2_ENDPOINT_URL=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEDIA_MAX_INPUT_BYTES=10000000
MEDIA_MAX_BYTES=600000
MEDIA_TARGET_MAX_WIDTH=800
MEDIA_TARGET_MAX_HEIGHT=600
MEDIA_JPEG_QUALITY=82
MEDIA_PHASH_HAMMING_THRESHOLD=8

# Sprint 7 beta release controls. Defaults are safe/off; enable only in a
# fake stack or approved beta window. Do not commit real user IDs.
FEATURE_BOT_ACCESS_ENABLED=false
FEATURE_LISTENER_SOURCES_ENABLED=false
FEATURE_AI_PROCESSING_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false
FEATURE_NLP_ENABLED=false
FEATURE_CONTENT_PUBLISHING_ENABLED=false
BETA_ALLOWLIST_USER_IDS=
