# EstateFlow standalone ingestion stack for a VPS.
# Copy to .env.ingestion, set every required value, and never commit that file.

LOG_LEVEL=INFO

# Host PostgreSQL (production database).
# This example targets the same VPS host; Compose maps the alias to its gateway.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=estateflow
DB_USER=estateflow__app_user
DB_PASSWORD=
MIGRATION_DB_USER=estateflow__dev_user
MIGRATION_DB_PASSWORD=

REDIS_PASSWORD=

RABBITMQ_USER=estateflow_pipeline
RABBITMQ_PASSWORD=
# URL-encode special characters in the username/password used in this URL.
RABBITMQ_URL=amqp://estateflow_pipeline:CHANGE_ME@rabbitmq:5672/
RABBITMQ_EXCHANGE=estateflow.events
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=5

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DEFAULT_TELEGRAM_LISTENER_ACCOUNT_KEY=acc_example
TELEGRAM_MEDIA_SESSION_NAME=media-example
TELEGRAM_SESSION_PATH=./data/sessions

# One line of valid JSON. Bootstrap is idempotent and enables existing rows.
# Replace [] with your real Telegram sources before the first fresh deployment.
INGESTION_SOURCES_JSON=[]

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_SEQUENCE=google/gemini-3.1-flash-lite,google/gemini-3.1-flash-lite-preview
OPENROUTER_TIMEOUT_SECONDS=30
AI_MIN_CONFIDENCE=0.72
RENTAL_MIN_CONFIDENCE=0.60
DEDUP_ADDRESS_SIMILARITY_THRESHOLD=0.75
DEDUP_DESCRIPTION_SIMILARITY_THRESHOLD=0.82
DEDUP_CONFIG_VERSION=estateflow.dedup.v2

# Set the endpoint and region for your S3-compatible provider.
R2_ENDPOINT_URL=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional incident notifications. Empty values disable them.
OPS_BOT_TOKEN=
OPS_CHAT_ID=

# Stable resource names. Change these only when intentionally creating a new dataset.
REDIS_VOLUME_NAME=estateflow_estateflow_redis_data
RABBITMQ_VOLUME_NAME=estateflow_estateflow_rabbitmq_data
INGESTION_NETWORK_NAME=estateflow-backbone
