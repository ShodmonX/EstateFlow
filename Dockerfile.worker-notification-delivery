FROM python:3.12-slim AS bundle
WORKDIR /build
COPY src /build/src
COPY services /build/services
COPY scripts/build_service_bundle.py /build/scripts/build_service_bundle.py
RUN python /build/scripts/build_service_bundle.py \
    --entrypoint /build/services/worker_notification_delivery/main.py \
    --entrypoint /build/services/common/runtime.py \
    --entrypoint /build/services/common/notification_payload.py \
    --source-root /build/src \
    --out /build/bundle/src

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src:/app
WORKDIR /app
COPY requirements/worker-notification-delivery.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --shell /usr/sbin/nologin estateflow
COPY --from=bundle /build/bundle/src /app/src
COPY services/__init__.py /app/services/__init__.py
COPY services/common /app/services/common
COPY services/worker_notification_delivery /app/services/worker_notification_delivery
RUN mkdir -p /app/data/sessions && chown -R estateflow:estateflow /app
USER estateflow
CMD ["python", "-m", "services.worker_notification_delivery.main"]
