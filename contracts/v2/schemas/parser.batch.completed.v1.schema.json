{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.estateflow.invalid/v2/parser.batch.completed.v1.schema.json",
  "title": "DRAFT parser.batch.completed v1",
  "allOf": [
    {
      "$ref": "https://contracts.estateflow.invalid/v2/envelope.v1.schema.json"
    },
    {
      "properties": {
        "event_type": {
          "const": "parser.batch.completed"
        },
        "producer": {
          "const": "source_parser"
        },
        "aggregate_kind": {
          "const": "parser_batch"
        },
        "payload": {
          "type": "object",
          "properties": {
            "batch_id": {
              "type": "string",
              "format": "uuid"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message_uid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "source_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "message_uid",
                  "source_revision"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "policy": {
              "$ref": "https://contracts.estateflow.invalid/v2/types.v1.schema.json#/$defs/policy"
            },
            "candidate_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "supersedes_batch_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retracts_candidate_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "outcome": {
              "enum": [
                "complete",
                "quarantined",
                "buffered"
              ]
            },
            "input_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "batch_id",
            "generation",
            "source_refs",
            "policy",
            "candidate_ids",
            "supersedes_batch_id",
            "retracts_candidate_ids",
            "outcome"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "quarantined",
                      "buffered"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "candidate_ids": {
                    "maxItems": 0
                  },
                  "retracts_candidate_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
